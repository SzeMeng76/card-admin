JWT_SECRET=change-this-to-a-long-random-string
ADMIN_PASSWORD=change-this-admin-password
DATABASE_PATH=/app/data/cards.db

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=change-this-webhook-secret
# 你的网站域名，用于自动设置 webhook
APP_URL=https://yourdomain.com

# Bitnob Card Issuing API (optional)
BITNOB_CLIENT_ID=your-client-id
BITNOB_CLIENT_SECRET=your-client-secret-sandbox-or-live
# Leave as https://api.bitnob.com for both sandbox and live
# The environment is determined by the secret key prefix (sandbox_ or live_)
BITNOB_BASE_URL=https://api.bitnob.com
